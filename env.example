# Copia in .env.local e compila i valori dal dashboard Supabase
# Project Settings → API
# Guida: docs/SETUP.md

VITE_SUPABASE_URL=https://eyyprcnbyhkygxiggais.supabase.co
VITE_SUPABASE_ANON_KEY=

# Vercel: impostare le stesse VITE_* in Project → Environment Variables
# (Production + Preview), poi fare un nuovo deploy.

# Solo Edge Functions (non nel browser). Esempio CLI:
# npx supabase secrets set APP_ENV=production
# npx supabase secrets set ALLOW_MOCK_PAYMENTS=false
#
# In development (opzionale):
# npx supabase secrets set ALLOW_MOCK_PAYMENTS=true APP_ENV=development MOCK_PAYMENT_ALLOWLIST=m.canalis@live.it
#
# Stripe (quando Zoe fornisce l’account):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
